{
  "name": "holmes-high-school-wordpress-plugins",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run build:content && npm run build:public",
    "build:content": "wp-scripts build --webpack-src-dir=wordpress/holmes-content-portal/src --output-path=wordpress/holmes-content-portal/build",
    "build:public": "wp-scripts build --webpack-src-dir=wordpress/holmes-public-site/src --output-path=wordpress/holmes-public-site/build",
    "lint": "wp-scripts lint-js \"wordpress/holmes-content-portal/src/**/*.{ts,tsx}\" \"wordpress/holmes-public-site/src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@wordpress/element": "^10.0.0",
    "@wordpress/scripts": "^35.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "postcss-selector-parser": "^7.1.7",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.0"
  }
}
